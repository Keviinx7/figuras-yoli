# Copia este archivo como `.env` en la raíz y ajusta los valores.
# NUNCA subas un `.env` real a Git. Genera SECRET_KEY con:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Entorno activo: development | testing | staging | production
APP_ENV=development

# Requerida en staging y production; >= 32 caracteres, no predecible.
SECRET_KEY=

# Opcional; por defecto: sqlite:///instance/tienda.db
# Ejemplo PostgreSQL: postgresql+psycopg://yoli:clave@127.0.0.1:5432/yoli
DATABASE_URL=

# Forzar modo debug en desarrollo (0/1). En production siempre se ignora.
FLASK_DEBUG=0

# Cookies de sesión.
SESSION_COOKIE_SECURE=0          # 1 cuando la web se sirve por HTTPS
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax      # Lax | Strict | None
SESSION_LIFETIME_HOURS=8

# Hosts permitidos separados por coma; vacío = sin restricción.
TRUSTED_HOSTS=

# Registro.
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FILE=                        # Vacío usa stderr (Gunicorn la captura).

# Sí/N° y seguridad detrás de un proxy (Nginx, terminate TLS).
BEHIND_PROXY=0                   # 1 cuando Nginx termina HTTPS
HSTS_ENABLED=0                   # 1 en producción con HTTPS activo
HSTS_MAX_AGE=31536000

# Limite del cuerpo de solicitudes en bytes (por defecto 64 KB).
MAX_CONTENT_LENGTH_BYTES=65536

# Carpeta de respaldos SQLite; vacío usa instance/backups.
BACKUP_DIR=

# Ruta alternativa del PDF del catálogo (opcional).
CATALOG_PDF=
# Correo: desarrollo funciona sin transporte; fake solo para pruebas locales.
# Guía SMTP real y prueba aislada: docs/smtp-real.md
# No activar hasta configurar remitente/proveedor y DB de prueba.
MAIL_ENABLED=false
MAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Clave SMTP/token/contraseña de aplicación; nunca contraseña normal si se exige token.
SMTP_PASSWORD=
# STARTTLS: 587 + TLS=true + SSL=false; TLS implícito: 465 + TLS=false + SSL=true.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Yoli Figuras de Fomix"
PUBLIC_BASE_URL=http://localhost:5000
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_LIFETIME_HOURS=24
ACCOUNT_RECOVERY_ENABLED=false
ACCOUNT_RECOVERY_LIFETIME_HOURS=1
ORDER_EMAIL_NOTIFICATIONS_ENABLED=false
